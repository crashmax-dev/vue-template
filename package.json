{
  "name": "@vue-workspace/root",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "pnpm": ">=11.8",
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:apps": "turbo run dev --filter='./apps/*'",
    "dev:ui": "turbo run dev --filter='./packages/ui'",
    "dev:packages": "turbo run dev --filter='./packages/*'",
    "build": "turbo run build --filter='./apps/*'",
    "build:ui": "turbo run build --filter='./packages/ui'",
    "build:packages": "turbo run build --filter='./packages/*'",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:browser": "pnpm --filter=@vue-workspace/playground test:browser",
    "test:unit-ui": "pnpm --filter=@vue-workspace/ui test:unit-ui",
    "type-check": "turbo run type-check",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "generate-api": "pnpm --filter=@vue-workspace/api generate-api",
    "clean": "turbo run clean && rm -rf .turbo",
    "check-update": "pnpm update -i -r -L"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.0.0",
    "@iconify-json/heroicons-outline": "1.2.1",
    "@pinia/testing": "1.0.3",
    "@types/jscodeshift": "17.3.0",
    "@types/node": "24.10.9",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/ui": "4.1.9",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.5.0",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-pinia": "0.4.2",
    "happy-dom": "20.10.6",
    "jscodeshift": "17.3.0",
    "playwright": "1.61.0",
    "prettier-plugin-css-order": "2.2.0",
    "sass-embedded": "1.100.0",
    "tsx": "4.22.4",
    "turbo": "2.9.18",
    "typescript": "6.0.3",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.0.16",
    "vite-plugin-static-copy": "4.1.1",
    "vite-plugin-vue-devtools": "8.1.3",
    "vitest": "4.1.9",
    "vitest-browser-vue": "2.1.0",
    "vue-tsc": "3.3.5"
  }
}
